FROM nginx:alpine

COPY frontend/index.html /usr/share/nginx/html/index.html
COPY frontend/admin.html /usr/share/nginx/html/admin.html
COPY frontend/manifest.json /usr/share/nginx/html/manifest.json
COPY frontend/sw.js /usr/share/nginx/html/sw.js
COPY frontend/offline.html /usr/share/nginx/html/offline.html
COPY frontend/a11y.css /usr/share/nginx/html/a11y.css
COPY frontend/analytics.js /usr/share/nginx/html/analytics.js
COPY frontend/consent-banner.js /usr/share/nginx/html/consent-banner.js
COPY frontend/robots.txt /usr/share/nginx/html/robots.txt
COPY frontend/sitemap.xml /usr/share/nginx/html/sitemap.xml
COPY frontend/.well-known /usr/share/nginx/html/.well-known
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
